# Copiei este arquivo como base para criar meu .env.
# Aqui deixo as configurações necessárias para o Back-End funcionar.
# Não envio o .env real para o GitHub, pois ele contém informações privadas.

# Configurações do meu banco de dados MySQL
# Estou utilizando o usuário específico da aplicação, em vez do root.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=SindromeX
DB_USER=sindromex_app
DB_PASSWORD=troque_esta_senha

# Defini quantas conexões simultâneas o sistema poderá manter no pool.
DB_POOL_SIZE=5

# Chave de segurança utilizada pela aplicação para assinar sessões e tokens.
# Gere uma chave aleatória e mantenha seu valor privado.
# Para gerar: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque_por_um_valor_aleatorio_longo

# Configurei a origem do Front-End que poderá acessar minha API.
# O endereço abaixo é o padrão que estou utilizando no desenvolvimento.
# Caso a porta ou o endereço do Front-End mudem, preciso atualizar aqui.
CORS_ORIGINS=http://localhost:5173

# Deixo o modo de depuração desativado por padrão.
# Durante o desenvolvimento, posso alterar para true se precisar investigar erros.
DEBUG=false

# Copie para .env e preencha. NUNCA envie o .env para o Git.

# Banco de dados (use o usuário criado por criar_usuario_app.sql, não o root)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=SindromeX
DB_USER=sindromex_app
DB_PASSWORD=troque_esta_senha
DB_POOL_SIZE=5

# Chave usada para assinar sessões/tokens. Gere uma aleatória e longa, por exemplo:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque_por_um_valor_aleatorio_longo

# Endereços do front-end autorizados a chamar a API (separados por vírgula)
CORS_ORIGINS=http://localhost:5173

# true apenas em desenvolvimento
DEBUG=false
